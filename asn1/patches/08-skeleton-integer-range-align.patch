# 08-skeleton-integer-range-align.patch
#
# 대상 : asn1c 런타임 (skeletons/INTEGER_aper.c 의 디코더)
#
# 증상 : APER 에서 범위(상한 − 하한 + 1)가 129~255 인 INTEGER 를 틀리게 읽는다. 디코더가 8비트 필드를 읽기 전에
#   항상 옥텟 경계로 정렬하기 때문이다. 성공으로 끝나면서 값만 틀리거나(NGAP ExpectedActivityPeriod 30 → 129),
#   뒤 필드가 밀려 PDU 전체가 실패한다. 같은 파일의 인코더는 맞게 부호화하므로 asn1c 끼리도 어긋난다.
#   V19.4.0 에서 F1AP 13개 정의(rootSequenceIndex (0..137), DUFSlotformatIndex (0..254) 등),
#   NGAP 4개 정의(ExpectedActivityPeriod, ExpectedIdlePeriod 등)가 해당한다.
#
# 근거 : X.691(02/2021) 11.5.7.1 — 범위가 255 이하면 정렬 없이 비트 필드로 부호화한다(129~255 는 8비트).
#   11.5.7.2 — 범위가 정확히 256 일 때만 옥텟 정렬한 1옥텟으로 부호화한다.
#
# 출처 : 우리가 썼다. 포크의 v1.5.3 과 vlm_master(e4ee5e48)에도 같은 결함이 남아 있다.
#
# 해결 : 정렬을 범위가 정확히 256 일 때만 한다. 인코더(같은 파일)의 조건과 같아진다.

--- a/skeletons/INTEGER_aper.c
+++ b/skeletons/INTEGER_aper.c
@@ -95,7 +95,12 @@
                     value = per_get_few_bits(pd, ct->range_bits);
                     if(value < 0) ASN__DECODE_STARVED;
                 } else if (ct->range_bits == 8) {
-                    if (aper_get_align(pd) < 0)
+                    /* X.691 11.5.7.1, 11.5.7.2: a range of 129..255 is an
+                     * 8-bit bit-field with no alignment. Only a range of
+                     * exactly 256 is octet-aligned (the encoder below
+                     * already does this). */
+                    if (ct->upper_bound - ct->lower_bound + 1 == 256
+                            && aper_get_align(pd) < 0)
                         ASN__DECODE_FAILED;
                     value = per_get_few_bits(pd, ct->range_bits);
                     if(value < 0) ASN__DECODE_STARVED;
