# 05-skeleton-opentype-discard-checks.patch
#
# 대상 : asn1c 런타임 (skeletons/OPEN_TYPE_aper.c 의 OPEN_TYPE_aper_unknown_type_discard_bytes)
#
# 증상 : 문법이 모르는 IE 를 버리는 함수가 두 가지 실패를 검사하지 않는다.
#   aper_get_length() 가 돌려준 음수(입력 부족)를 길이로 쓰고,
#   per_get_many_bits() 가 실패해도(IE 길이가 남은 바이트보다 큼) 성공을 돌려준다.
#
# 출처 : mouse07410/asn1c 커밋 0ecf9c92 (2025-09-22) 를 그대로 옮겼다(바꾼 줄 없음).
#   (전에는 음수 검사만 Makefile 의 sed 한 줄로 넣었다. sed 는 대상 줄이 없어도 성공으로 끝난다.)


--- a/skeletons/OPEN_TYPE_aper.c
+++ b/skeletons/OPEN_TYPE_aper.c
@@ -142,12 +142,17 @@
     ssize_t bytes;
     int repeat;
     asn_dec_rval_t rv;
+    size_t initial_consumed = pd->moved;  /* Track initial position */
 
     rv.consumed = 0;
     rv.code = RC_FAIL;
 
     do {
         bytes = aper_get_length(pd, -1, -1, -1, &repeat);
+        if (bytes < 0) {
+            /* Invalid length - return error */
+            return rv;
+        }
         if (bytes > 10 * ASN_DUMMY_BYTES)
         {
             return rv;
@@ -159,7 +164,13 @@
                 return rv;
         }
 
-        per_get_many_bits(pd, (dummy_ptr ? dummy_ptr : dummy), 0, bytes << 3);
+        if (per_get_many_bits(pd, (dummy_ptr ? dummy_ptr : dummy), 0, bytes << 3) < 0) {
+            /* Error during bit consumption */
+            if (dummy_ptr) {
+                FREEMEM(dummy_ptr);
+            }
+            return rv;
+        }
 
         if (dummy_ptr)
         {
@@ -168,7 +179,9 @@
         }
     } while (repeat);
 
-     rv.code = RC_OK;
-     return rv;
+    /* Update consumed to reflect actual bits consumed */
+    rv.consumed = pd->moved - initial_consumed;
+    rv.code = RC_OK;
+    return rv;
 #undef ASN_DUMMY_BYTES
 }
