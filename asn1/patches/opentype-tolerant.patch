# ============================================================================
# opentype-tolerant.patch
#
# 대상 : asn1c 가 생성하는 skeleton 의 OPEN_TYPE_aper.c / OPEN_TYPE_uper.c 수정.
#
# 근거 : 실제 무선 환경에서는 현재 문법 버전(F1AP 18.8.0 등)이 모르는 더 최신 릴리스의 
#   IE 가 섞여 올 수 있음. open type(= IE id/procedure code 로
#   고르는 가변 필드)의 선택자가 문법에 없으면 asn1c 기본 동작은 ASN__DECODE_FAILED —
#   즉 해당 IE 하나 때문에 PDU 전체 디코드를 실패함. 
#
# 해결 : 모르는 open type 은 길이만큼 건너뜀(aper_open_type_skip) 
# ============================================================================
--- a/OPEN_TYPE_aper.c	2026-10-13 17:47:19.907288188 +0900
+++ b/OPEN_TYPE_aper.c	2026-10-13 17:47:19.915990695 +0900
@@ -5,6 +5,9 @@
  */
 #include <asn_internal.h>
 #include <OPEN_TYPE.h>
+
+/* Defined in dec/asn1_glue.c (count of skipped unknown open types). */
+extern unsigned long asn_portran_opentype_skipped;
 #include <constr_CHOICE.h>
 #include <aper_opentype.h>
 
@@ -30,7 +33,17 @@
 
     selected = elm->type_selector(td, sptr);
     if(!selected.presence_index) {
-        ASN__DECODE_FAILED;
+        /* The open type's selector (IE id /
+         * procedure code) is unknown to this grammar version, e.g. a newer
+         * 3GPP release IE. Skip its length-prefixed octets and leave the
+         * CHOICE empty (presence 0) instead of failing the whole PDU. */
+        if(aper_open_type_skip(opt_codec_ctx, pd) < 0) {
+            ASN__DECODE_FAILED;
+        }
+        asn_portran_opentype_skipped++;
+        rv.code = RC_OK;
+        rv.consumed = 0;
+        return rv;
     }
 
     /* Fetch the pointer to this member */
--- a/OPEN_TYPE_uper.c	2026-10-13 17:47:19.910715537 +0900
+++ b/OPEN_TYPE_uper.c	2026-10-13 17:47:19.916127520 +0900
@@ -5,6 +5,9 @@
  */
 #include <asn_internal.h>
 #include <OPEN_TYPE.h>
+
+/* Defined in dec/asn1_glue.c (count of skipped unknown open types). */
+extern unsigned long asn_portran_opentype_skipped;
 #include <constr_CHOICE.h>
 #include <uper_opentype.h>
 
@@ -30,7 +33,17 @@
 
     selected = elm->type_selector(td, sptr);
     if(!selected.presence_index) {
-        ASN__DECODE_FAILED;
+        /* The open type's selector (IE id /
+         * procedure code) is unknown to this grammar version, e.g. a newer
+         * 3GPP release IE. Skip its length-prefixed octets and leave the
+         * CHOICE empty (presence 0) instead of failing the whole PDU. */
+        if(uper_open_type_skip(opt_codec_ctx, pd) < 0) {
+            ASN__DECODE_FAILED;
+        }
+        asn_portran_opentype_skipped++;
+        rv.code = RC_OK;
+        rv.consumed = 0;
+        return rv;
     }
 
     /* Fetch the pointer to this member */
--- a/constr_SEQUENCE_aper.c	2026-10-13 17:47:19.912811838 +0900
+++ b/constr_SEQUENCE_aper.c	2026-10-13 17:47:19.927970616 +0900
@@ -169,8 +169,10 @@
         if(!epres) ASN__DECODE_STARVED;
 
         /* Get the extensions map */
-        if(per_get_many_bits(pd, epres, 0, bmlength))
+        if(per_get_many_bits(pd, epres, 0, bmlength)) {
+            FREEMEM(epres);
             ASN__DECODE_STARVED;
+        }
 
         memset(&epmd, 0, sizeof(epmd));
         epmd.buffer = epres;
@@ -179,8 +181,10 @@
                   td->name, bmlength, *epres);
 
         /* Deal with padding */
-        if (aper_get_align(pd) < 0)
+        if (aper_get_align(pd) < 0) {
+            FREEMEM(epres);
             ASN__DECODE_STARVED;
+        }
 
         /* Go over extensions and read them in */
         for(edx = specs->first_extension; edx < td->elements_count; edx++) {
